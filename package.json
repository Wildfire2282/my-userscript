{
  "name": "my-userscript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wildfire2282 的用户脚本 monorepo：多个脚本共享同一套 Shadow DOM UI 设计体系。",
  "workspaces": [
    "scripts/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:min": "node tools/build.mjs --minify",
    "sync": "python tools/sync.py",
    "sync:check": "python tools/sync.py --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:meta": "node tools/check-meta.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:browser": "node tools/browser-check.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:meta && npm run check:size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
