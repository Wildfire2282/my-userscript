{
  "name": "my-userscript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wildfire2282 的用户脚本 monorepo：多个脚本共享同一套 Shadow DOM UI 设计体系。",
  "workspaces": [
    "scripts/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:min": "node tools/build.mjs --minify",
    "sync": "python tools/sync.py",
    "sync:check": "python tools/sync.py --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tools/browser-check.mjs",
    "build:ui-demo": "vite build --config packages/userscript-ui/vite.lib.config.ts && vite build --config packages/userscript-ui/vite.demo.config.ts && vite build --config packages/userscript-ui/vite.demo.config.ts --mode minimal",
    "test:ui-e2e": "npm run build:ui-demo && vitest run --config packages/userscript-ui/vitest.e2e.config.ts",
    "check:ui-safety": "node packages/userscript-ui/scripts/check-safety.mjs",
    "check:ui-tokens": "node packages/userscript-ui/scripts/check-tokens.mjs",
    "check:meta": "node tools/check-meta.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:meta && npm run check:ui-safety && npm run check:ui-tokens && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
