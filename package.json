{
  "name": "my-userscript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wildfire2282 的用户脚本 monorepo：多个脚本共享同一套 Shadow DOM UI 设计体系。",
  "workspaces": [
    "scripts/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun tools/build.mjs",
    "sync": "bun tools/sync.mjs",
    "sync:check": "bun tools/sync.mjs --check",
    "lint": "bunx oxlint --deny-warnings",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "bun tools/browser-check.mjs",
    "check:ui-safety": "bun packages/userscript-ui/scripts/check-safety.mjs",
    "check:ui-tokens": "bun packages/userscript-ui/scripts/check-tokens.mjs",
    "check:meta": "bun tools/check-meta.mjs",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run check:meta && bun run check:ui-safety && bun run check:ui-tokens && bun run test:browser"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
