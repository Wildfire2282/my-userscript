{
  "name": "my-userscript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wildfire2282 的用户脚本 monorepo：多个脚本共享同一套 Shadow DOM UI 设计体系。",
  "workspaces": [
    "scripts/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun tools/build.mjs",
    "sync": "python tools/sync.py",
    "sync:check": "python tools/sync.py --check",
    "lint": "eslint .",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "bun tools/browser-check.mjs",
    "check:ui-safety": "bun packages/userscript-ui/scripts/check-safety.mjs",
    "check:ui-tokens": "bun packages/userscript-ui/scripts/check-tokens.mjs",
    "check:meta": "bun tools/check-meta.mjs",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run check:meta && bun run check:ui-safety && bun run check:ui-tokens && bun run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
